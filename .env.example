REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Public Add Tree page (optional — embed key for a dedicated subdomain):
# REACT_APP_PUBLIC_ADD_TREE_KEY=ta_your_key
# Link: https://your-app.vercel.app/add-tree?key=ta_your_key

# Soil sensor fetch (Web Bluetooth → RDL908 SoilSensor-XXXX)
# Default is live BLE. Set true only for desktop UI work without hardware.
# REACT_APP_SENSOR_DEMO=true

# Controller live pins (TreeESP32Controller → Turso lilygo_live_state) are read
# by supabase function controller-live-state. Set Edge secrets, not React env:
#   supabase secrets set TURSO_DATABASE_URL=...
#   supabase secrets set TURSO_AUTH_TOKEN=...
